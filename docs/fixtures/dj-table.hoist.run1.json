{
  "library": [
    {
      "type": "Button",
      "description": "Momentary push button; fires once on each press. Draws no label of its own.",
      "props": {
        "onPress": "() => void",
        "tone?": "'neutral' | 'accent' | 'danger'"
      }
    },
    {
      "type": "Toggle",
      "description": "Latching on/off control; each activation flips its boolean state and reports the new value.",
      "props": {
        "on": "boolean",
        "onChange": "(on: boolean) => void",
        "tone?": "'neutral' | 'accent' | 'danger'"
      }
    },
    {
      "type": "Knob",
      "description": "Rotary control mapping angular drag to a value between min and max; can run continuously or snap to a fixed number of steps, and can be centered/bipolar.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v: number) => void",
        "mode?": "'continuous' | 'stepped'",
        "steps?": "number",
        "bipolar?": "boolean"
      }
    },
    {
      "type": "Fader",
      "description": "Linear slider mapping travel to a value between min and max; orientation selectable for vertical channel/level use or horizontal blend use.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v: number) => void",
        "orientation?": "'vertical' | 'horizontal'",
        "bipolar?": "boolean"
      }
    },
    {
      "type": "JogWheel",
      "description": "Large rotating wheel that emits relative rotation deltas for scratching and pitch-bending; can reflect playback spin and playhead position.",
      "props": {
        "onScrub": "(delta: number) => void",
        "playhead?": "number",
        "spinning?": "boolean"
      }
    },
    {
      "type": "Pad",
      "description": "Trigger pad that fires on press; can indicate a stored/active state (e.g. a set cue point).",
      "props": {
        "onPress": "() => void",
        "on?": "boolean"
      }
    },
    {
      "type": "LevelMeter",
      "description": "Display of an audio signal level as a filling meter, optionally holding a peak indicator.",
      "props": {
        "level": "number",
        "peak?": "number"
      }
    },
    {
      "type": "WaveformDisplay",
      "description": "Renders an audio waveform with a moving playhead and optional beat-grid overlay; supports zoom and click-to-seek.",
      "props": {
        "waveform": "number[]",
        "playhead": "number",
        "beatGrid?": "number[]",
        "zoom?": "number",
        "onSeek?": "(position: number) => void"
      }
    },
    {
      "type": "Readout",
      "description": "Passive text/numeric display of a supplied value; formatting and labeling are the component's job.",
      "props": {
        "value": "string"
      }
    },
    {
      "type": "TextInput",
      "description": "Single-line editable text field emitting its current string as it changes.",
      "props": {
        "value": "string",
        "onChange": "(v: string) => void",
        "placeholder?": "string"
      }
    },
    {
      "type": "FolderTree",
      "description": "Hierarchical selection of folders/crates; reports the chosen node id.",
      "props": {
        "options": "{ id: string; label: string; parentId?: string }[]",
        "value": "string",
        "onChange": "(id: string) => void"
      }
    },
    {
      "type": "TrackList",
      "description": "Scrollable multi-column list of tracks; reports the highlighted track and, on activation, the track to open, with current sort field/direction.",
      "props": {
        "options": "{ id: string; title: string; artist: string; bpm: number; key: string; duration: string }[]",
        "value": "string",
        "onChange": "(id: string) => void",
        "onActivate?": "(id: string) => void",
        "sortBy?": "string",
        "sortDir?": "'asc' | 'desc'"
      }
    },
    {
      "type": "SortControl",
      "description": "Row of column headers that selects a sort field and toggles ascending/descending, reporting both.",
      "props": {
        "options": "{ id: string; label: string }[]",
        "value": "string",
        "direction": "'asc' | 'desc'",
        "onChange": "(id: string, direction: 'asc' | 'desc') => void"
      }
    },
    {
      "type": "Selector",
      "description": "Single-choice selection among a supplied set of options; reports the chosen option id.",
      "props": {
        "options": "{ id: string; label: string }[]",
        "value": "string",
        "onChange": "(id: string) => void"
      }
    }
  ],
  "components": [
    {
      "name": "DJ Table: Track Library Browser",
      "features": {
        "Search Bar": [
          "TextInput"
        ],
        "Folder Crate Tree": [
          "FolderTree"
        ],
        "Track List": [
          "TrackList"
        ],
        "Sort Headers": [
          "SortControl"
        ],
        "BPM Key Columns": [],
        "Preview Button": [
          "Button"
        ],
        "Load To Deck A": [
          "Button"
        ],
        "Load To Deck B": [
          "Button"
        ]
      }
    },
    {
      "name": "DJ Table: Master Waveform Display",
