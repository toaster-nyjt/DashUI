          "Toggle"
        ],
        "Cue Button": [
          "Button"
        ],
        "Pitch Fader": [
          "Fader"
        ],
        "Waveform Strip": [
          "WaveformDisplay"
        ],
        "Hot Cue Pads": [
          "Pad"
        ],
        "Loop Controls": [
          "Button"
        ],
        "Sync Button": [
          "Toggle"
        ],
        "Track Info Display": [
          "Readout"
        ],
        "BPM Display": [
          "Readout"
        ],
        "Keylock Toggle": [
          "Toggle"
        ]
      }
    },
    {
      "name": "DJ Table: Central Mixer",
      "features": {
        "Channel Faders": [
          "Fader"
        ],
        "Crossfader": [
          "Fader"
        ],
        "EQ Knobs": [
          "Knob"
        ],
        "Gain Trim": [
          "Knob"
        ],
        "Channel VU Meters": [
          "LevelMeter"
        ],
        "Cue PFL Buttons": [
          "Toggle"
        ],
        "Master Volume": [
          "Knob"
        ],
        "Headphone Mix": [
          "Knob"
        ]
      }
    },
    {
      "name": "DJ Table: Deck B (Right)",
      "features": {
        "Jog Wheel": [
          "JogWheel"
        ],
        "Play Pause Button": [
          "Toggle"
        ],
        "Cue Button": [
          "Button"
        ],
        "Pitch Fader": [
          "Fader"
        ],
        "Waveform Strip": [
          "WaveformDisplay"
        ],
        "Hot Cue Pads": [
          "Pad"
        ],
        "Loop Controls": [
          "Button"
        ],
        "Sync Button": [
          "Toggle"
        ],
        "Track Info Display": [
          "Readout"
        ],
        "BPM Display": [
          "Readout"
        ],
        "Keylock Toggle": [
          "Toggle"
        ]
      }
    },
    {
      "name": "DJ Table: Effects Rack",
      "features": {
        "FX Unit Slots": [],
        "Effect Selector": [
          "Selector"
        ],
        "Dry Wet Knob": [
          "Knob"
        ],
        "Beat Multiplier": [
