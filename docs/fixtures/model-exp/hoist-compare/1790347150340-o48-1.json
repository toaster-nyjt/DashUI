{
  "library": [
    {
      "type": "JogWheel",
      "description": "Large rotary vinyl-style wheel; user drags to scratch/nudge. Emits incremental rotation deltas in normalized turns; value is current normalized angular position 0-1.",
      "props": {
        "value": "number",
        "onScrub": "(delta: number) => void",
        "spinning?": "boolean"
      }
    },
    {
      "type": "Knob",
      "description": "Rotary control mapping angle to a value within min..max. Continuous by default, or snaps to the provided steps when mode is stepped. value/onChange in the unit defined by min..max.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v: number) => void",
        "mode?": "'continuous' | 'stepped'",
        "steps?": "number[]"
      }
    },
    {
      "type": "Fader",
