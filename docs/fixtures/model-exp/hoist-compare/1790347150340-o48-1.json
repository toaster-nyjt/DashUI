      }
    },
    {
      "type": "Waveform",
      "description": "Scrolling waveform lane rendering amplitude data with optional beatgrid, cue markers and a moving playhead (all in seconds/time units); onSeek emits target time when the user clicks/drags. Zoom sets visible time span.",
