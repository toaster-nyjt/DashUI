{
  "library": [
    {
      "type": "JogWheel",
      "description": "Large rotary vinyl-style wheel; dragging rotates it and emits incremental angular delta in revolutions (negative = backward) plus a touch state for scratch vs bend; 'spinAngle' (degrees) drives the visual rotation.",
      "props": {
        "spinAngle?": "number",
        "onScrub": "(deltaRevolutions:number)=>void",
        "onTouchChange?": "(touching:boolean)=>void"
      }
    },
    {
      "type": "Knob",
      "description": "Rotary control; vertical/circular drag maps to a value within min..max, optionally snapping to discrete values. Emits value in its own units.",
      "props": {
        "value": "number",
        "onChange": "(v:number)=>void",
        "min": "number",
        "max": "number",
        "mode?": "'continuous' | 'stepped'",
        "steps?": "number[]",
        "detents?": "number[]",
        "bipolar?": "boolean"
      }
    },
    {
      "type": "Fader",
      "description": "Linear throw control, vertical or horizontal; dragging the cap maps position to a value within min..max. Emits value in its own units.",
      "props": {
        "value": "number",
        "onChange": "(v:number)=>void",
        "min": "number",
        "max": "number",
        "orientation?": "'vertical' | 'horizontal'",
        "steps?": "number[]",
        "centerDetent?": "boolean"
      }
    },
    {
      "type": "PushButton",
      "description": "Momentary button; fires on press (and optionally release). Face content supplied by the component.",
      "props": {
        "onPress": "()=>void",
        "onRelease?": "()=>void",
        "active?": "boolean",
        "disabled?": "boolean",
        "tone?": "'neutral' | 'accent' | 'danger'",
        "children?": "React.ReactNode"
      }
    },
    {
      "type": "ToggleButton",
      "description": "Latching on/off button; pressing flips the boolean state and emits it.",
      "props": {
        "on": "boolean",
        "onChange": "(on:boolean)=>void",
        "disabled?": "boolean",
        "tone?": "'neutral' | 'accent' | 'danger'",
        "children?": "React.ReactNode"
      }
    },
    {
      "type": "CuePad",
      "description": "Performance pad; short press triggers its slot, long/secondary press clears it. 'assigned' shows whether a cue point is stored; 'triggered' flashes on activation.",
      "props": {
        "assigned": "boolean",
        "onTrigger": "()=>void",
        "onClear?": "()=>void",
        "triggered?": "boolean",
        "children?": "React.ReactNode"
      }
    },
    {
      "type": "SegmentedSelector",
      "description": "Row/grid of mutually exclusive options; clicking one selects it and emits its id. Options are single-label choices supplied at runtime.",
      "props": {
        "options": "{ id: string; label: string }[]",
        "value": "string",
        "onChange": "(id:string)=>void"
      }
    },
    {
      "type": "Readout",
      "description": "Non-interactive alphanumeric display of one or more labeled fields (e.g. title, BPM, key, elapsed/remaining time, loop length); values given as strings or numbers in the component's own units.",
      "props": {
        "fields": "{ id: string; label?: string; value: string | number; unit?: string }[]"
      }
    },
    {
      "type": "LevelMeter",
      "description": "Segmented audio level meter; 'level' is normalized 0-1 per channel, optional 'peak' 0-1 holds the peak marker.",
      "props": {
        "levels": "number[]",
        "peaks?": "number[]",
        "orientation?": "'vertical' | 'horizontal'"
      }
    },
    {
      "type": "StatusIndicator",
      "description": "Small state lamp; lit when active, with an optional semantic tone for warning/clip states.",
      "props": {
        "active": "boolean",
        "tone?": "'neutral' | 'accent' | 'danger'"
      }
    },
    {
      "type": "WaveformLane",
      "description": "Scrolling waveform strip rendering normalized 0-1 amplitude peaks with optional beatgrid lines and cue markers (positions in seconds), a playhead in seconds, and a zoom factor (visible seconds per view); clicking or dragging emits a target time in seconds.",
      "props": {
        "peaks": "number[]",
        "duration": "number",
        "playhead": "number",
        "zoom?": "number",
        "beatgrid?": "number[]",
        "markers?": "{ id: string; time: number; label?: string }[]",
        "onSeek?": "(timeSeconds:number)=>void"
      }
    },
    {
      "type": "SearchInput",
      "description": "Single-line text entry; emits the current query string as it is typed and on submit.",
      "props": {
        "value": "string",
        "onChange": "(q:string)=>void",
        "onSubmit?": "(q:string)=>void",
        "placeholder?": "string"
      }
    },
    {
      "type": "TreeSelector",
      "description": "Hierarchical, expandable list of nodes (folders/playlists); selecting a node emits its id.",
      "props": {
        "nodes": "{ id: string; label: string; children?: any[] }[]",
        "value": "string",
        "onChange": "(id:string)=>void",
        "expanded?": "string[]",
        "onExpandedChange?": "(ids:string[])=>void"
      }
    },
    {
      "type": "TrackListTable",
      "description": "Sortable multi-column list of records; clicking a row selects it (emits id), double-click activates it, clicking a column header emits the sort key and direction.",
      "props": {
        "columns": "{ id: string; label: string }[]",
        "rows": "{ id: string; [field: string]: string | number }[]",
        "value": "string",
        "onChange": "(id:string)=>void",
        "onActivate?": "(id:string)=>void",
        "sortKey?": "string",
        "sortDir?": "'asc' | 'desc'",
        "onSortChange?": "(key:string, dir:'asc'|'desc')=>void"
      }
    }
  ],
