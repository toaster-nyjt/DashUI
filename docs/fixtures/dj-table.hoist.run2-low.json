{
  "library": [
    {
      "type": "SearchInput",
      "description": "Single-line text input for typing a query; emits the current text as it changes.",
      "props": {
        "value": "string",
        "onChange": "(v: string) => void"
      }
    },
    {
      "type": "TreeSelector",
      "description": "Hierarchical list of nodes (folders/crates) that can be expanded and one selected; emits the chosen node id.",
      "props": {
        "options": "{ id: string; label: string; parentId?: string }[]",
        "value": "string",
        "onChange": "(id: string) => void"
      }
    },
    {
      "type": "TrackList",
      "description": "Scrollable, sortable tabular list of items with multiple columns; one row can be selected and optionally activated.",
      "props": {
        "options": "{ id: string; cells: Record<string, string | number> }[]",
        "columns": "{ key: string; sortable?: boolean }[]",
        "sort": "{ key: string; dir: 'asc' | 'desc' }",
        "onSortChange": "(s: { key: string; dir: 'asc' | 'desc' }) => void",
        "value": "string",
        "onChange": "(id: string) => void",
        "onActivate": "(id: string) => void"
      }
    },
    {
      "type": "Button",
      "description": "Momentary push button that fires an action on press.",
      "props": {
        "onPress": "() => void",
        "tone?": "'neutral' | 'accent' | 'danger'"
      }
    },
    {
      "type": "ToggleButton",
      "description": "Latching button that holds an on/off state and toggles it on press.",
      "props": {
        "on": "boolean",
        "onChange": "(on: boolean) => void",
        "tone?": "'neutral' | 'accent' | 'danger'"
      }
    },
    {
      "type": "Switch",
      "description": "Sliding on/off switch that latches between two states.",
      "props": {
        "on": "boolean",
        "onChange": "(on: boolean) => void"
      }
    },
    {
      "type": "Knob",
      "description": "Rotary control mapping angular drag to a value between min and max; snaps to a discrete set when steps is supplied.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v: number) => void",
        "steps?": "number[]"
      }
    },
    {
      "type": "Fader",
      "description": "Linear travel control mapping position to a value between min and max, in either orientation.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v: number) => void",
        "orientation?": "'vertical' | 'horizontal'"
      }
    },
    {
      "type": "Pad",
      "description": "Trigger pad that fires on press and can show an active/assigned state.",
      "props": {
        "onPress": "() => void",
        "active?": "boolean"
      }
    },
    {
      "type": "Readout",
      "description": "Passive alphanumeric display of a supplied value or values.",
      "props": {
        "value": "string | number"
      }
    },
    {
      "type": "LevelMeter",
      "description": "Displays a signal level as a moving bar with optional peak indication.",
      "props": {
        "level": "number",
        "peak?": "number"
      }
    },
    {
      "type": "Waveform",
      "description": "Renders audio waveform data with an optional moving playhead, beat grid overlay and zoom factor.",
      "props": {
        "data": "number[]",
        "playhead?": "number",
        "beatGrid?": "number[]",
        "zoom?": "number"
      }
    },
    {
      "type": "JogWheel",
      "description": "Rotational wheel surface that emits incremental scrub deltas as it is turned, reflecting spin state.",
      "props": {
        "onScrub": "(delta: number) => void",
        "spinning?": "boolean"
      }
    },
    {
      "type": "Selector",
      "description": "Presents a flat set of options and emits the chosen one.",
      "props": {
        "options": "{ id: string; label: string }[]",
        "value": "string",
        "onChange": "(id: string) => void"
      }
    }
  ],
  "components": [
    {
      "name": "DJ Table: Track Library Browser",
      "features": {
        "Search Bar": [
          "SearchInput"
        ],
        "Folder Crate Tree": [
          "TreeSelector"
        ],
        "Track List": [
          "TrackList"
        ],
        "Sort Headers": [
          "TrackList"
        ],
        "BPM Key Columns": [],
        "Preview Button": [
          "Button"
        ],
        "Load To Deck A": [
          "Button"
        ],
        "Load To Deck B": [
          "Button"
        ]
      }
    },
    {
      "name": "DJ Table: Master Waveform Display",
      "features": {
        "Dual Waveform Lanes": [
          "Waveform"
        ],
        "Playhead Markers": [
          "Waveform"
        ],
        "Beat Grid": [
          "Waveform"
        ],
        "Time Display": [
          "Readout"
        ],
        "Zoom Control": [
          "Knob"
        ]
      }
    },
    {
      "name": "DJ Table: Deck A (Left)",
      "features": {
        "Jog Wheel": [
          "JogWheel"
        ],
        "Play Pause Button": [
          "ToggleButton"
        ],
        "Cue Button": [
          "Button"
        ],
        "Pitch Fader": [
          "Fader"
        ],
        "Waveform Strip": [
          "Waveform"
        ],
        "Hot Cue Pads": [
          "Pad"
        ],
        "Loop Controls": [
          "Button",
          "Readout"
        ],
        "Sync Button": [
          "ToggleButton"
        ],
        "Track Info Display": [
          "Readout"
        ],
        "BPM Display": [
          "Readout"
        ],
        "Keylock Toggle": [
          "Switch"
        ]
      }
    },
    {
      "name": "DJ Table: Central Mixer",
      "features": {
        "Channel Faders": [
          "Fader"
        ],
        "Crossfader": [
          "Fader"
        ],
        "EQ Knobs": [
          "Knob"
        ],
        "Gain Trim": [
          "Knob"
        ],
        "Channel VU Meters": [
          "LevelMeter"
        ],
        "Cue PFL Buttons": [
          "ToggleButton"
        ],
        "Master Volume": [
          "Knob"
        ],
        "Headphone Mix": [
          "Knob"
        ]
      }
    },
    {
      "name": "DJ Table: Deck B (Right)",
      "features": {
        "Jog Wheel": [
          "JogWheel"
        ],
        "Play Pause Button": [
          "ToggleButton"
        ],
        "Cue Button": [
          "Button"
        ],
        "Pitch Fader": [
          "Fader"
        ],
        "Waveform Strip": [
          "Waveform"
        ],
        "Hot Cue Pads": [
          "Pad"
        ],
        "Loop Controls": [
          "Button",
          "Readout"
        ],
        "Sync Button": [
          "ToggleButton"
        ],
        "Track Info Display": [
          "Readout"
        ],
        "BPM Display": [
          "Readout"
        ],
        "Keylock Toggle": [
          "Switch"
        ]
      }
    },
    {
      "name": "DJ Table: Effects Rack",
      "features": {
        "FX Unit Slots": [],
        "Effect Selector": [
          "Selector"
        ],
        "Dry Wet Knob": [
          "Knob"
        ],
        "Beat Multiplier": [
          "Knob"
        ],
        "Assign Deck Buttons": [
          "ToggleButton"
        ],
        "On Off Toggle": [
          "Switch"
        ]
      }
    }
  ]
}