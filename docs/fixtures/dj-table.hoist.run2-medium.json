{
  "library": [
    {
      "type": "TextInput",
      "description": "A single-line text entry field; the user types and the string value updates.",
      "props": {
        "value": "string",
        "onChange": "(v: string) => void"
      }
    },
    {
      "type": "TreeBrowser",
      "description": "A hierarchical folder/crate tree; presents nested nodes and lets the user select one, emitting its id.",
      "props": {
        "nodes": "{ id: string; label: string; parentId?: string }[]",
        "value": "string",
        "onChange": "(id: string) => void"
      }
    },
    {
      "type": "TrackList",
      "description": "A selectable, multi-column list of rows; the user selects a row (onChange) and can activate it (onActivate); sort order is driven externally.",
      "props": {
        "rows": "{ id: string; cells: (string | number)[] }[]",
        "value": "string",
        "onChange": "(id: string) => void",
        "onActivate": "(id: string) => void"
      }
    },
    {
      "type": "SortHeader",
      "description": "A row of column headers; clicking a column selects it as the sort key and toggles ascending/descending, emitting the sort state.",
      "props": {
        "columns": "{ id: string; label: string }[]",
        "value": "{ columnId: string; direction: 'asc' | 'desc' }",
        "onChange": "(v: { columnId: string; direction: 'asc' | 'desc' }) => void"
      }
    },
    {
      "type": "Button",
      "description": "A momentary push button that fires an action on press.",
      "props": {
        "onPress": "() => void",
        "tone": "'neutral' | 'accent' | 'danger'"
      }
    },
    {
      "type": "Toggle",
      "description": "A latching on/off control that flips a boolean state.",
      "props": {
        "on": "boolean",
        "onChange": "(on: boolean) => void",
        "tone": "'neutral' | 'accent' | 'danger'"
      }
    },
    {
      "type": "Knob",
      "description": "A rotary control mapping drag angle to a value between min and max; snaps to discrete positions when steps is given, and can be bipolar/center-detented.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v: number) => void",
        "steps": "number[]",
        "centered": "boolean"
      }
    },
    {
      "type": "Fader",
      "description": "A linear sliding control mapping position to a value between min and max; orientation selects vertical or horizontal travel, centered marks a blend/detent midpoint.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v: number) => void",
        "orientation": "'vertical' | 'horizontal'",
        "centered": "boolean"
      }
    },
    {
      "type": "Waveform",
      "description": "A waveform display surface rendering sample data with an overlaid moving playhead and optional beat-grid markers and zoom; supports scrubbing/seeking.",
      "props": {
        "data": "number[]",
        "playhead": "number",
        "beatGrid": "number[]",
        "zoom": "number",
        "onScrub": "(pos: number) => void"
      }
    },
    {
      "type": "Readout",
      "description": "A passive display of a single textual or numeric value.",
      "props": {
        "value": "string | number"
      }
    },
    {
      "type": "JogWheel",
      "description": "A large rotating platter; dragging emits rotational deltas for scratching and pitch-bending, and it spins to reflect playback.",
      "props": {
        "onScrub": "(delta: number) => void",
        "position": "number",
        "playing": "boolean"
      }
    },
    {
      "type": "Pad",
      "description": "A performance trigger pad that fires on press and reflects an active/assigned state.",
      "props": {
        "onPress": "() => void",
        "active": "boolean"
      }
    },
    {
      "type": "LevelMeter",
      "description": "A signal level display driven by a real-time level value with an optional peak indicator.",
      "props": {
        "level": "number",
        "peak": "number"
      }
    },
    {
      "type": "Selector",
      "description": "A compact chooser presenting a set of options; the user picks one and its id is emitted.",
      "props": {
        "options": "{ id: string; label: string }[]",
        "value": "string",
        "onChange": "(id: string) => void"
      }
    }
  ],
  "components": [
    {
      "name": "DJ Table: Track Library Browser",
      "features": {
        "Search Bar": [
          "TextInput"
        ],
        "Folder Crate Tree": [
          "TreeBrowser"
        ],
        "Track List": [
          "TrackList"
        ],
        "Sort Headers": [
          "SortHeader"
        ],
        "BPM Key Columns": [],
        "Preview Button": [
          "Button"
        ],
        "Load To Deck A": [
          "Button"
        ],
        "Load To Deck B": [
          "Button"
        ]
      }
    },
    {
      "name": "DJ Table: Master Waveform Display",
      "features": {
        "Dual Waveform Lanes": [
