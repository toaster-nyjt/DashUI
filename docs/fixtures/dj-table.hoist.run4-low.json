{
  "library": [
    {
      "type": "Knob",
      "description": "Rotary control mapping angular drag to a value within min..max; continuous by default or snapping to fixed detents when steps is given. Also used for zoom. value is in the min..max range.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v:number)=>void",
        "mode?": "'continuous' | 'stepped'",
        "steps?": "number[]"
      }
    },
    {
      "type": "Fader",
      "description": "Linear travel control mapping handle position to a value within min..max, vertical or horizontal. value is in the min..max range.",
      "props": {
        "min": "number",
        "max": "number",
        "value": "number",
        "onChange": "(v:number)=>void",
        "orientation?": "'vertical' | 'horizontal'"
      }
    },
    {
      "type": "Button",
      "description": "Momentary push control that fires onPress each activation; optional face content.",
      "props": {
        "onPress": "()=>void",
        "children?": "React.ReactNode"
      }
    },
    {
      "type": "Toggle",
      "description": "Latching control with a boolean on state that flips via onChange; optional face content.",
      "props": {
        "on": "boolean",
        "onChange": "(on:boolean)=>void",
        "children?": "React.ReactNode"
      }
    },
    {
      "type": "Pad",
      "description": "Performance pad that fires onPress when struck and can show a lit/assigned state; optional face content.",
      "props": {
        "on": "boolean",
        "onPress": "()=>void",
        "children?": "React.ReactNode"
      }
    },
    {
      "type": "JogWheel",
      "description": "Circular platter whose rotation drag emits a delta/absolute position for scratching and nudging; value is playback position offset (normalized).",
      "props": {
        "value": "number",
        "onChange": "(v:number)=>void"
      }
    },
    {
      "type": "Waveform",
      "description": "Waveform surface rendering amplitude data with a moving playhead (normalized 0-1), optional beat-grid markers (normalized positions), optional zoom factor and optional scrub callback.",
      "props": {
        "data": "number[]",
        "playhead": "number",
        "beatGrid?": "number[]",
        "zoom?": "number",
        "onScrub?": "(pos:number)=>void"
      }
    },
    {
      "type": "Readout",
      "description": "Passive display of a value or text/rich content supplied by the component.",
      "props": {
        "value?": "string | number",
        "children?": "React.ReactNode"
      }
    },
    {
      "type": "LevelMeter",
      "description": "Signal level meter displaying a normalized 0-1 level.",
      "props": {
        "value": "number"
      }
    },
    {
      "type": "TextInput",
      "description": "Single-line text entry emitting its current string via onChange.",
      "props": {
        "value": "string",
        "onChange": "(v:string)=>void"
      }
    },
    {
      "type": "Selector",
      "description": "Presents a flat set of options and reports the chosen id via onChange; onActivate distinguishes selecting from acting on an option.",
      "props": {
        "options": "{ id: string; label: string }[]",
        "value": "string",
        "onChange": "(id:string)=>void",
        "onActivate?": "(id:string)=>void"
      }
    },
    {
      "type": "TreeSelector",
      "description": "Hierarchical browser of nested nodes that reports the selected node id via onChange.",
      "props": {
        "nodes": "{ id: string; label: string; children?: any[] }[]",
        "value": "string",
        "onChange": "(id:string)=>void"
      }
    }
  ],
  "components": [
    {
      "name": "DJ Table: Track Library Browser",
      "features": {
        "Search Bar": [
          "TextInput"
        ],
        "Folder Crate Tree": [
          "TreeSelector"
